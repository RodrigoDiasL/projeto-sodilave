# Ambiente de produção da aplicação interna Sodilave.
# Não utilizar www.sodilave.pt: esse endereço fica reservado ao website institucional.
NODE_ENV=production
APP_URL=https://producao.sodilave.pt
APP_VERSION=0.9.8

# Utilizador MySQL dedicado apenas a esta aplicação.
# O runtime usa mysql2/promise com um pool pequeno de ligações.
DATABASE_URL=mysql://UTILIZADOR:SENHA@localhost:3306/BASE_DE_DADOS

# Gerar uma chave aleatória longa. Mínimo: 32 caracteres.
SESSION_SECRET=SUBSTITUIR_POR_CHAVE_ALEATORIA_COM_PELO_MENOS_32_CARACTERES

# Só necessários na primeira execução de npm run db:production, se a base estiver vazia.
# Remover INITIAL_ADMIN_PIN do cPanel imediatamente após a criação do primeiro administrador.
INITIAL_ADMIN_NAME=Rodrigo
INITIAL_ADMIN_PIN=SUBSTITUIR_POR_8_DIGITOS

# Backups adicionais da base de dados.
BACKUP_DIR=/home/sodilave/backups/producao-db
BACKUP_RETENTION_DAYS=30
# MYSQLDUMP_BIN=mysqldump
